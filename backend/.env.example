# Comma-separated origins allowed to call the API.
CHATTERBOX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Runtime limits.
MAX_UPLOAD_MB=50
MAX_TEXT_CHARS=12000
CHUNK_TEXT_CHARS=850
SILENCE_SECONDS_BETWEEN_CHUNKS=0.18
TTS_MAX_WORKERS=1

# Optional device override. Usually leave unset and let PyTorch detect CUDA.
# CHATTERBOX_DEVICE=cuda

# Optional V-TTS local weight directory.
# VTTS_ZEROSHOT_MODEL_DIR=/models/zeroshot-vietnamese
